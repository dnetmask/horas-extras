# Proxy TLS -> HTTP interno. nginx termina el HTTPS con el certificado
# autofirmado (ver scripts/generar-certificado-autofirmado.sh) y reenvia en
# texto plano al contenedor "app" dentro de la red interna de Docker - ese
# contenedor nunca queda expuesto directamente al host ni a internet.
#
# Variables sustituidas por `envsubst` al arrancar el contenedor (ver
# CMD en el Dockerfile de nginx, mas abajo en docker-compose.yml):
#   $APP_UPSTREAM  -> host:puerto interno del contenedor de la app (app:8090)

server {
    listen 443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 20m;

    location / {
        proxy_pass http://${APP_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# Puerto 80 solo para redirigir a HTTPS (por si alguien entra sin "https://").
server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}
