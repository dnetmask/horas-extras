# Plantilla para el ambiente de PRUEBA (staging) - copiar a .env dentro del
# checkout separado de staging (ver deploy/docker/LEEME-STAGING.md).
# Vive en su propio contenedor/DB/volumen gracias a STACK_SUFFIX, en el
# mismo servidor que produccion, sin tocarla.

POSTGRES_USER=horas_extras_staging
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=horas_extras_staging
DATABASE_URL=postgresql://horas_extras_staging:cambiar_esta_clave@db:5432/horas_extras_staging

SESSION_SECRET=cambiar_por_una_cadena_aleatoria_larga

# Misma IP publica del servidor, PUERTO DISTINTO al de produccion (53395).
APP_BASE_URL=https://161.18.232.231:53396
PORT=8090

NGINX_HTTPS_PORT=53396
NGINX_HTTP_PORT=8082

# Aisla los contenedores/imagen/volumen de los de produccion en el mismo host.
STACK_SUFFIX=-staging

# Mismo App Registration de Azure que produccion (no hace falta crear uno
# nuevo) - pero hay que agregarle una Redirect URI adicional para este
# puerto: https://161.18.232.231:53396/auth/callback
AZURE_TENANT_ID=8cad3d70-facd-4b74-a95e-08458c90d001
AZURE_CLIENT_ID=8a8cedab-e7cd-49a5-81dc-4fecdcda288d
AZURE_CLIENT_SECRET=

# Vacio a proposito: en staging NO se deben enviar correos reales a
# lideres/gerencia mientras se prueban cambios. Los envios simplemente
# fallaran (quedan solo en el log), sin romper el resto de la app.
GRAPH_MAIL_FROM=

ADMIN_EMAIL_INICIAL=

# true a proposito en staging: permite entrar como cualquier usuario de
# prueba sin depender del SSO real, para probar mas rapido.
DEV_AUTH_BYPASS=true
