# Nunca subir secretos ni datos locales a Vercel.
.env
.env.*
certs/
backups/
# Respaldos sueltos en la raiz. Ojo: un "*.sql" sin "/" tambien excluiria
# prisma/migrations/*/migration.sql y el build no podria migrar la base.
/*.dump
/*.sql
/*.sql.gz

# Piezas exclusivas del despliegue Docker.
Dockerfile
docker-compose.yml
docker-entrypoint.sh
deploy/

# Vercel instala dependencias en su propio build.
node_modules/
tests/
