# Copiar a .env y completar antes de levantar el contenedor.

# --- Base de datos ---
POSTGRES_USER=horas_extras
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=horas_extras
# Dentro de docker-compose el host es el nombre del servicio ("db")
DATABASE_URL=postgresql://horas_extras:cambiar_esta_clave@db:5432/horas_extras

# --- Sesion ---
# Cadena aleatoria larga (ej. `openssl rand -hex 32`). Cambiar en produccion.
SESSION_SECRET=cambiar_por_una_cadena_aleatoria_larga

# --- URL publica de la app (la que ve el usuario, detras del firewall/reverse proxy) ---
APP_BASE_URL=https://horas-extras.netmask.co
PORT=8090

# --- SSO Microsoft Entra ID (Azure AD) ---
# Crear un "App Registration" en el tenant de Netmask con:
#  - Redirect URI: {APP_BASE_URL}/auth/callback
#  - Permiso de aplicacion "Mail.Send" (Microsoft Graph), consentido por un admin
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Envio de correo (Microsoft Graph, mismo App Registration de arriba) ---
# Buzon desde el que se envian las notificaciones (ej. notificaciones@netmask.co)
GRAPH_MAIL_FROM=

# --- Solo para el primer arranque ---
# Email que quedara precargado como admin (rol confirmado al primer login SSO).
# Sin esto, el primer usuario que inicie sesion por SSO se vuelve admin automaticamente.
ADMIN_EMAIL_INICIAL=

# --- Solo para desarrollo local, NUNCA activar en produccion ---
# Si es "true", permite iniciar sesion sin SSO real eligiendo un usuario de
# prueba (ver /auth/dev-login). Sirve para probar la app sin credenciales de
# Azure todavia.
DEV_AUTH_BYPASS=false
